# copia para .env (local) ou configura como Variables no Railway

# Senha única compartilhada pelo time pra entrar
APP_PASSWORD=troque-isto

# Chave aleatória pra assinar cookies de sessão (rode: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=troque-por-string-aleatoria

# PAT do GitHub com escopo de issues (fine-grained > Issues: Read & Write no efddrsn/capim-docs)
GITHUB_PAT=ghp_xxx_ou_github_pat_xxx

# Opcionais (defaults: efddrsn/capim-docs, ../guias)
# GITHUB_OWNER=efddrsn
# GITHUB_REPO=capim-docs
# GUIAS_DIR=../guias

# Em produção, define a URL pública pra o app validar Origin de requisições POST
# PUBLIC_BASE_URL=https://capim-docs.up.railway.app
# NODE_ENV=production

# Token bearer pro endpoint MCP HTTP (/mcp). Sem isso, /mcp devolve 503.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Esse token é compartilhado pelo Custom Connector do Claude Teams; identidade
# de quem está usando vai pelo campo `author` de cada tool de escrita.
MCP_BEARER_TOKEN=troque-por-string-aleatoria
